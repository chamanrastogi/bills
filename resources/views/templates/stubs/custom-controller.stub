<?php

namespace App\Http\Controllers\Backend;

use App\Http\Controllers\Controller;
use App\Models\{{ModelStudly}};
use App\Traits\CommonTrait;
use Illuminate\Http\Request;

class {{ModelStudly}}Controller extends Controller
{
    use CommonTrait;

    /**
     * Display a listing of the resource.
     */
    public function index()
    {
        $data = {{ModelStudly}}::get();
        return view('backend.{{ModelLower}}.all_{{ModelLower}}', compact('data'));
    }

    /**
     * Show the form for creating a new resource.
     */
    public function create()
    {
        return view('backend.{{ModelLower}}.add_{{ModelLower}}');
    }

    /**
     * Store a newly created resource in storage.
     */
    public function store(Request $request)
    {
        $validated = $request->validate([
            'name' => 'required',
        ]);

        {{ModelStudly}}::create([
            'name' => $request->name,
        ]);

        $notification = [
            'message' => '{{ModelStudly}} Added Successfully',
            'alert-type' => 'success',
        ];

        return redirect()->back()->with($notification);
    }

    /**
     * Show the form for editing the specified resource.
     */
    public function edit({{ModelStudly}} ${{ModelLower}})
    {
        return view('backend.{{ModelLower}}.edit_{{ModelLower}}', compact('{{ModelLower}}'));
    }

    /**
     * Update the specified resource in storage.
     */
    public function update(Request $request, {{ModelStudly}} ${{ModelLower}})
    {
        ${{ModelLower}}->update([
            'name' => $request->name,
        ]);

        $notification = [
            'message' => '{{ModelStudly}} Updated Successfully',
            'alert-type' => 'success',
        ];

        return redirect()->back()->with($notification);
    }

    /**
     * Remove the specified resource from storage.
     */
    public function destroy({{ModelStudly}} ${{ModelLower}})
    {
        ${{ModelLower}}->delete();

        $notification = [
            'message' => '{{ModelStudly}} Deleted Successfully',
            'alert-type' => 'success',
        ];

        return redirect()->back()->with($notification);
    }
}
